<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TargetFramework comes from Directory.Build.props (net48). -->

    <RootNamespace>EBookMeta.App</RootNamespace>
    <AssemblyName>EBookMetaEditor</AssemblyName>
    <Description>EBookMetaEditor — ebook and comic metadata editor.</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- The only executable in the product. There is no CLI and no separate
         setup program: context-menu registration lives in the Settings form.

         Literally one file, so there is no App.config either. Left to itself
         the SDK still synthesises an <exe>.config carrying nothing but a
         <supportedRuntime> hint, which the shim does not need: the CLR picks
         4.x from the image's own runtime version, and net48 is present on every
         OS this app targets. Binding redirects are equally unnecessary, since
         EmbeddedAssemblies answers by simple name and ignores versions. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same .ico twice, deliberately. ApplicationIcon above puts it in the
         exe's Win32 resources, which is what Explorer draws and what the
         context-menu verb refers to as "<exe>,0"; Windows cannot read a managed
         resource. This copy is what Form.Icon needs, because WinForms picks the
         16 px title-bar and 32 px Alt+Tab frames out of a multi-frame Icon
         object, and only the managed stream gives it all five. -->
    <EmbeddedResource Include="icon.ico" LogicalName="EBookMetaEditor.icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface languages, one file each. A wildcard rather than a list: adding
         a language is adding a file to Languages/, and Strings finds it by
         enumerating what is embedded.

         WithCulture=false because en.lang and de.lang otherwise look exactly like
         culture-specific resources to MSBuild, which would build them into
         satellite assemblies in subfolders — the opposite of the single file
         everything else here is arranged around. -->
    <EmbeddedResource Include="Languages\*.lang">
      <!-- $(AssemblyName), not the name spelled out: Strings derives the same prefix
           from the assembly at run time, so a rename cannot leave the two disagreeing
           and the whole interface falling back to raw key names. -->
      <LogicalName>$(AssemblyName).Languages.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- WinForms on net48 is wired with classic references. UseWindowsForms is a
       modern-.NET property and does nothing here. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 has no WinForms implicit usings, so declare them once here rather
         than at the top of every form. -->
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />

    <!-- Utils/ is the plumbing any Windows desktop application would want and
         nothing about books: a separate namespace so the boundary is visible, and
         a global using so naming it costs no line anywhere else. -->
    <Using Include="EBookMeta.App.Utils" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EBookMeta.Core\EBookMeta.Core.csproj" />
  </ItemGroup>

  <!--
    "A single executable. EBookMetaEditor.exe and nothing else."

    net48 has no PublishSingleFile, so the dependencies are embedded as
    resources and served back by EmbeddedAssemblies at runtime. This runs after
    ResolveReferences, which is what populates ReferenceCopyLocalPaths, and
    before PrepareResources, which is what turns EmbeddedResource items into
    manifest resources.

    The same items are then removed from the copy-local set, so bin/ holds the
    exe alone. That is not tidiness: it means an F5 run resolves assemblies
    through exactly the path a released build uses, instead of silently finding
    DLLs on disk and leaving the embedded path untested until a user hits it.
  -->
  <Target Name="EmbedReferencedAssemblies" AfterTargets="ResolveReferences">

    <ItemGroup>
      <_EBookMetaEmbeddedDependency Include="@(ReferenceCopyLocalPaths)"
                                    Condition="'%(Extension)' == '.dll'" />

      <EmbeddedResource Include="@(_EBookMetaEmbeddedDependency)">
        <!-- Must match EmbeddedAssemblies.Prefix. -->
        <LogicalName>EBookMetaEditor.Embedded.%(Filename)%(Extension)</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>

      <!-- Everything, not just the .dll items: the reference .pdb and the
           148 KB EBookMeta.Core.xml doc file have no business in the output
           folder either. Compilation reads ReferencePath, which is untouched. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>

    <Message Importance="normal"
             Text="Embedded into $(AssemblyName).exe: @(_EBookMetaEmbeddedDependency->'%(Filename)%(Extension)', ', ')" />

  </Target>

</Project>
