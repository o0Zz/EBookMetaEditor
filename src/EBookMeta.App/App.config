<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!-- The System.Memory package brings its own System.Runtime.CompilerServices.Unsafe
         and System.Numerics.Vectors; binding redirects are generated automatically
         by the SDK, so none are hand-written here. -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>

  <System.Windows.Forms.ApplicationConfigurationSection>
    <!-- Required alongside app.manifest for per-monitor DPI on .NET Framework;
         the manifest alone leaves WinForms controls unscaled. -->
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
