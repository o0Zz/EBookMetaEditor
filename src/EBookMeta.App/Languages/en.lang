batch.copied.many = {0} cells copied.
batch.nothingToCopy = Select the cells to copy first.
batch.clipboardBusy = Another application is holding the clipboard. Try again.
batch.paste.empty = There is nothing to paste.
batch.paste.selectCell = Select a cell you can edit first.
batch.pasted.one = Pasted into 1 cell.
batch.pasted.many = Pasted into {0} cells.
batch.pastedSkipped.one = Pasted into 1 cell; {1} could not store it.
batch.pastedSkipped.many = Pasted into {0} cells; {1} could not store it.
batch.cleared.one = 1 cell cleared.
batch.cleared.many = {0} cells cleared.
batch.clearedSkipped.one = 1 cell cleared; {1} could not store it.
batch.clearedSkipped.many = {0} cells cleared; {1} could not store it.

batch.number.selectRows = Select the rows to number first.
batch.numbered.one = 1 row numbered.
batch.numbered.many = {0} rows numbered.
batch.numberedSkipped.one = 1 row numbered; {1} had no series to number.
batch.numberedSkipped.many = {0} rows numbered; {1} had no series to number.

batch.rowDirty = Save this row before opening it on its own — it has unsaved edits here.

batch.summary.files.one = 1 file
batch.summary.files.many = {0} files
